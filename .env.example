APP_NAME="Garage Rental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL on localhost. Create an empty database named garage_rental first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garage_rental
DB_USERNAME=root
DB_PASSWORD=

# Session is only used for CSRF and flash messages, so keep it as long as the JWT.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_ALGO=HS256
AUTH_GUARD=api

# Values are in minutes. 43200 = 30 days, meant for local demo only.
# Use a short value such as 60 for anything that is not a demo.
JWT_TTL=43200
JWT_REFRESH_TTL=43200